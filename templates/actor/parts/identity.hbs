<section class="ts-panel panel-identity" aria-label="{{localize "TS.Champion.Panels.identity"}}">
  <div class="portrait-wrap">
    <div class="portrait">
      <img
        src="{{actor.img}}"
        alt="{{actor.name}}"
        {{#if editable}}
        data-action="editImage"
        data-edit="img"
        {{/if}}
          data-tooltip="{{actor.name}}"
        >
    </div>
    <label class="boon-toggle">
      <input type="checkbox" name="system.boon" {{checked system.boon}}>
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <path d="M32 4 L38 24 L58 32 L38 40 L32 60 L26 40 L6 32 L26 24 Z"></path>
      </svg>
      <span>{{localize "TS.Champion.FIELDS.boon.label"}}</span>
    </label>
  </div>

  <div class="identity-fields">
    <label class="field">
      <span class="field-label">{{localize "TS.Champion.Identity.name"}}</span>
      <input type="text" name="name" value="{{actor.name}}">
    </label>
    <label class="field">
      <span class="field-label">{{localize "TS.Champion.FIELDS.origin.label"}}</span>
      <input type="text" name="system.origin" value="{{system.origin}}">
    </label>
    <div class="field">
      <span class="field-label">{{localize "TS.Champion.Identity.kin"}}</span>
      <ul class="identity-items">
        {{#each kin}}
        <li class="identity-item" data-item-id="{{id}}" data-document-class="Item">
          <button type="button" class="identity-item-name" data-action="viewDoc">{{label}}</button>
          {{#if @root.editable}}
          <button type="button" class="item-control" data-action="deleteDoc">
            <i class="fa-solid fa-xmark"></i>
          </button>
          {{/if}}
        </li>
        {{else}}
        <li class="identity-item-empty">{{localize "TS.Champion.Identity.noKin"}}</li>
        {{/each}}
      </ul>
    </div>
    <div class="field">
      <span class="field-label">{{localize "TS.Champion.Identity.way"}}</span>
      <ul class="identity-items">
        {{#each ways}}
        <li class="identity-item" data-item-id="{{id}}" data-document-class="Item">
          <button type="button" class="identity-item-name" data-action="viewDoc">{{label}}</button>
          {{#if @root.editable}}
          <button type="button" class="item-control" data-action="deleteDoc">
            <i class="fa-solid fa-xmark"></i>
          </button>
          {{/if}}
        </li>
        {{else}}
        <li class="identity-item-empty">{{localize "TS.Champion.Identity.noWay"}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
