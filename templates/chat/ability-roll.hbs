<div class="ability-roll {{rollOutcome}}">
  <header class="ability-roll-header">
    <span class="ability">{{abilityLabel}}</span>
    {{#if advantageLabel}}<span class="roll-mode">{{advantageLabel}}</span>{{/if}}
  </header>

  <div class="ability-roll-result">
    <div class="result-block">
      <span class="result-label">{{localize "TS.Roll.rolled"}}</span>
      <span class="die{{#if isCritical}} critical{{/if}}">{{die}}</span>
    </div>
    {{#unless isCritical}}
    <span class="versus">&le;</span>
    <div class="result-block">
      <span class="result-label">{{localize "TS.Roll.target"}}</span>
      <span class="abilityTarget">{{target}}</span>
      {{#if modifier}}<span class="target-breakdown">{{abilityValue}} {{modifier}}</span>{{/if}}
    </div>
    {{/unless}}
  </div>

  <div class="outcomeLabel">{{outcomeLabel}}</div>

  {{{rollHTML}}}
</div>
