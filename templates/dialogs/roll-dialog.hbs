<div class="form-group">
  <label>{{localize "TS.Roll.modifier"}}</label>
  <div class="form-fields">
    <input type="number" name="modifier" value="0" min="-3" max="3" step="1">
  </div>
</div>

<div class="form-group">
  <label>{{localize "TS.Roll.advantage"}}</label>
  <div class="form-fields">
    <input type="checkbox" name="advantage">
  </div>
</div>

<div class="form-group">
  <label>{{localize "TS.Roll.disadvantage"}}</label>
  <div class="form-fields">
    <input type="checkbox" name="disadvantage">
  </div>
</div>
