<div class="form-group">
  <label for="ts-roll-modifier">{{localize "TS.Roll.modifier"}}</label>
  <div class="form-fields">
    <input type="number" id="ts-roll-modifier" name="modifier" value="0"
      min="-{{maxModifier}}" max="{{maxModifier}}" step="1">
  </div>
</div>

<div class="form-group">
  <label for="ts-roll-advantage">{{localize "TS.Roll.advantage"}}</label>
  <div class="form-fields">
    <input type="checkbox" id="ts-roll-advantage" name="advantage">
  </div>
</div>

<div class="form-group">
  <label for="ts-roll-disadvantage">{{localize "TS.Roll.disadvantage"}}</label>
  <div class="form-fields">
    <input type="checkbox" id="ts-roll-disadvantage" name="disadvantage" {{#if encumbered}}checked disabled{{/if}}>
  </div>
  {{#if encumbered}}
  <p class="hint">{{localize "TS.Inventory.encumberedHint"}}</p>
  {{/if}}
</div>